{
  "name": "payload-better-editor",
  "version": "1.0.0",
  "description": "A Volto-inspired live editor for Payload CMS — edit pages inline with a block-aware sidebar",
  "license": "MIT",
  "author": "scorpio-99",
  "repository": {
    "type": "git",
    "url": "https://github.com/scorpio-99/payload-better-editor"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "editor",
    "live-editor",
    "cms"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client.ts",
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix"
  },
  "peerDependencies": {
    "lucide-react": ">=0.577.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@swc/cli": "0.6.0",
    "@swc/core": "1.10.7",
    "@types/node": "22.5.4",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "copyfiles": "2.4.1",
    "eslint": "^9.16.0",
    "rimraf": "6.0.1",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/client.js",
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
